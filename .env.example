SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
INVITE_LINK_BASE_URL=https://linkchurch.space

# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# Automatic dev (pick one):
#   - Cursor/VS Code: open project and press Run (uses .vscode/settings.json)
#   - Terminal: make run
#   - Manual: flutter run --dart-define-from-file=.env
#
# Production CI: add SUPABASE_URL and SUPABASE_ANON_KEY as GitHub repo secrets
# (.github/workflows/build.yml builds automatically on push to main)
